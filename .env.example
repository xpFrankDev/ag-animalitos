# Desarrollo local y VPS: copia este archivo como .env y reemplaza cada valor.
# No subas .env al repositorio.
APP_HOST_IP=127.0.0.1
APP_PORT=8080
# MariaDB solo se publica en loopback; usa un túnel SSH para conectarte desde DBeaver.
DB_PUERTO_LOCAL=3307
MARIADB_ROOT_PASSWORD=valor_local_solo_desarrollo
MARIADB_DATABASE=ag_loteria
MARIADB_USER=ag_aplicacion
MARIADB_PASSWORD=valor_aplicacion_local
MARIADB_MIGRACIONES_USUARIO=ag_migraciones
MARIADB_MIGRACIONES_CONTRASENA=valor_migraciones_local
PUERTO=3000
CORS_ORIGEN=http://localhost:8080
DB_NOMBRE=ag_loteria
DB_APLICACION_USUARIO=ag_aplicacion
DB_APLICACION_CONTRASENA=valor_aplicacion_local
DB_MIGRACIONES_USUARIO=ag_migraciones
DB_MIGRACIONES_CONTRASENA=valor_migraciones_local
JWT_SECRETO=reemplaza_por_un_secreto_largo_aleatorio
# Cuenta raíz: es obligatoria para inicializar una base vacía.
USUARIO_BANQUERO_INICIAL=banquero_inicial
CONTRASENA_BANQUERO_INICIAL=reemplaza_esta_contrasena
# Datos de demostración: solo para desarrollo local. En producción debe quedar en false.
SEMILLA_DATOS_DEMO=false
USUARIO_GRUPERO_INICIAL=grupero_demo
CONTRASENA_GRUPERO_INICIAL=reemplaza_esta_contrasena
USUARIO_AGENCIA_INICIAL=agencia_demo
CONTRASENA_AGENCIA_INICIAL=reemplaza_esta_contrasena
# Zona horaria de la operación: la venta, los cierres y la numeración diaria la usan.
ZONA_HORARIA=America/Caracas
# Documentación de la API: en producción se deja deshabilitada.
SWAGGER_HABILITADO=false
# Bloqueo de acceso tras intentos fallidos (3 intentos, 5 minutos; al tercer bloqueo, permanente).
ACCESO_INTENTOS_PERMITIDOS=3
ACCESO_MINUTOS_BLOQUEO=5
ACCESO_BLOQUEOS_ANTES_DE_BLOQUEO_PERMANENTE=3
# Calificación automática de premios: toma los resultados pendientes y actualiza los tickets.
CALIFICACION_ACTIVA=true
CALIFICACION_INTERVALO_MS=60000
# Servicio ScrapResultados: cuenta de solo lectura/escritura para resultados automáticos.
# MARIADB_SCRAP_* y SCRAP_DB_* son el mismo usuario; se aceptan ambos nombres.
MARIADB_SCRAP_USUARIO=scrap_resultados
MARIADB_SCRAP_CONTRASENA=valor_scrap_local
SCRAP_DB_USUARIO=scrap_resultados
SCRAP_DB_CONTRASENA=valor_scrap_local
SCRAP_ZONA_HORARIA=America/Caracas
SCRAP_EXPRESION_CRON=3,17,33,47 8-19 * * *
SCRAP_TIEMPO_ESPERA_HTTP_MS=20000
